#!/bin/bash
if [ "$1" = "python" ] && [ "$2" = "list" ]; then
  echo '[{"version": "3.12.12", "implementation": "cpython"}]'
  exit 0
fi
echo "uv $*"
cd $(dirname $0)
cd ../../../../../..
pwd
if [ "$1" = "pip" ] && [ "$2" = "install" ]; then
  cp repository/pip/pip/default/bin/pip project/software/python/bin
elif [ "$1" = "python" ] && [ "$2" = "install" ]; then
  STAGE=""
  for i in "$@"; do
    if [ "$i" = "--install-dir" ]; then WANT=1; elif [ -n "$WANT" ]; then STAGE="$i"; WANT=""; fi
  done
  [ -z "$STAGE" ] && STAGE="project/software/.uv-staging"
  mkdir -p "$STAGE"
  cp -a repository/python/python/default "$STAGE/cpython-3.12"
fi
